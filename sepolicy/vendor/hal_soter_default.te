type hal_soter_default, domain;
hal_server_domain(hal_soter_default, hal_soter)

type hal_soter_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_soter_default)

allow hal_soter_default tee_device:chr_file rw_file_perms;
allow hal_soter_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_soter_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;

binder_call(hal_soter_default, servicemanager)
